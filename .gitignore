# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfplan
terraform/crash.log

# Python
__pycache__/
*.pyc
.venv/
venv/

# Secrets - never committed, created out-of-band by scripts/. Broad patterns
# on purpose after an earlier incident where a stray notepad save
# (ConvoScore.env, ConvoScore.env.txt) landed outside the original narrow
# ".env" rule - see DECISIONS.md.
.env
*.env
*.env.txt
!.env.example
*.local.yaml
secrets/

# OS/editor
.DS_Store
*.swp
